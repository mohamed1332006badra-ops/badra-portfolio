# ==========================================
# BADRA PORTFOLIO 2030 — ENVIRONMENT VARIABLES
# ==========================================
# Copy this file to .env.local for local development.
# Configure these variables in your Vercel Project Settings for Production.

# [PUBLIC] Base canonical URL for SEO, Open Graph, and sitemap generation
NEXT_PUBLIC_SITE_URL=

# [SERVER-ONLY] Optional AI provider keys for AI Project Scoper
# If unset, the app uses its built-in deterministic architecture analyzer.
OPENAI_API_KEY=
GEMINI_API_KEY=

# [SERVER-ONLY] Optional webhook URL for forwarding contact inquiries
CONTACT_NOTIFICATION_WEBHOOK_URL=
